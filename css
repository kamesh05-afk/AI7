* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid #333;
}

.logo {
    font-size: 30px;
    font-weight: bold;
    background: white;
    color: black;
    padding: 8px 14px;
    border-radius: 8px;
}

header span {
    color: #aaa;
    font-size: 14px;
}

main {
    max-width: 850px;
    margin: auto;
    padding: 25px 15px;
}

.hero {
    text-align: center;
    padding: 35px 10px;
}

.hero h1 {
    font-size: 38px;
    margin-bottom: 15px;
}

.hero p {
    color: #aaa;
    line-height: 1.6;
}

.chat-container {
    background: #151515;
    border: 1px solid #333;
    border-radius: 15px;
    padding: 15px;
}

.chat-box {
    height: 300px;
    overflow-y: auto;
    padding: 10px;
}

.message {
    padding: 12px;
    margin: 10px 0;
    border-radius: 10px;
    max-width: 85%;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.bot {
    background: #292929;
}

.user {
    background: #ffffff;
    color: #000;
    margin-left: auto;
}

.input-area {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

input {
    flex: 1;
    min-width: 0;
    padding: 14px;
    border-radius: 8px;
    border: 1px solid #555;
    background: #222;
    color: white;
    outline: none;
}

button {
    padding: 12px 20px;
    background: white;
    color: black;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #ccc;
}

#status {
    color: #999;
    font-size: 12px;
    margin-top: 12px;
}

.features {
    margin-top: 40px;
    text-align: center;
}

.features h2 {
    margin-bottom: 20px;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.feature-grid div {
    background: #191919;
    padding: 18px 8px;
    border: 1px solid #333;
    border-radius: 10px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #777;
    margin-top: 30px;
}

@media (max-width: 500px) {
    header {
        flex-direction: column;
    }

    .hero h1 {
        font-size: 30px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }
}
